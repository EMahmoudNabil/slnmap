<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Assembly name is the invoked command, so help usage and the MCP server name read "slnmap". -->
    <AssemblyName>slnmap</AssemblyName>
    <Description>Slnmap (sln-map) — a semantic map of your .sln for AI coding agents. Analyze a .NET solution into a queryable code graph, serve it over MCP, and inspect index status.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>slnmap</ToolCommandName>
    <PackageId>Slnmap</PackageId>
    <Version>0.8.2</Version>
    <RollForward>Major</RollForward>
    <PackageReadmeFile>nuget-readme.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Mahmoud Nabil</Authors>
    <Copyright>Copyright (c) 2026 Mahmoud Nabil</Copyright>
    <PackageProjectUrl>https://slnmap.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EMahmoudNabil/slnmap</RepositoryUrl>
    <PackageTags>dotnet;roslyn;mcp;ai;code-analysis;claude-code;knowledge-graph</PackageTags>
    <PackageReleaseNotes>Bugfix release. analyze progress no longer floods redirected/CI output
(one line per document became milestone lines: stage changes + every 10 percent; interactive
terminals keep the single overwriting line) -- #16, found by the first external install audit.
viz no longer stacks edge-count labels when several edge kinds connect the same two nodes:
parallel bundles curve apart so lines and counts stay legible at the collapsed level -- #17.
No graph or tool-behavior changes; upgrading needs no re-analysis.
Source: https://github.com/EMahmoudNabil/slnmap</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget-readme.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\viz-template.html" LogicalName="viz-template.html" />
    <EmbeddedResource Include="Resources\vis-network.min.js" LogicalName="vis-network.min.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Slnmap.Analysis\Slnmap.Analysis.csproj" />
    <ProjectReference Include="..\Slnmap.Core\Slnmap.Core.csproj" />
    <ProjectReference Include="..\Slnmap.Mcp\Slnmap.Mcp.csproj" />
    <ProjectReference Include="..\Slnmap.Storage\Slnmap.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Slnmap.Tests" />
  </ItemGroup>

</Project>
