<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Assembly name is the invoked command, so help usage and the MCP server name read "slnmap". -->
    <AssemblyName>slnmap</AssemblyName>
    <Description>Slnmap (sln-map) — a semantic map of your .sln for AI coding agents. Analyze a .NET solution into a queryable code graph, serve it over MCP, and inspect index status.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>slnmap</ToolCommandName>
    <PackageId>Slnmap</PackageId>
    <Version>0.14.1</Version>
    <RollForward>Major</RollForward>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Copyright>Copyright (c) 2026 the Slnmap authors. All rights reserved.</Copyright>
    <PackageProjectUrl>https://slnmap.dev</PackageProjectUrl>
    <PackageTags>dotnet;roslyn;mcp;ai;code-analysis;claude-code;knowledge-graph</PackageTags>
    <PackageReleaseNotes>Fixed: slnmap watch never saw a save on macOS (the readiness line was printed before
the file watcher started; symlinked solution directories are now followed to their real path).
Fixed: controllers whose [Route]/[Http*] attributes don't resolve (usually an unrestored project)
were called conventionally routed; they are now disclosed as having unresolved route attributes.
Fixed: identical refusals on one action are counted separately; find_unused_symbols under a project
scope reports symbols it can't attribute instead of dropping them.

Added: stale-restore detection (a package declared after the last restore) in analyze, status,
every MCP answer and doctor. impact_analysis and find_endpoint mark inferred frontend links.
macOS CI.

Changed: find_circular_dependencies(namespace) about 10x faster on large graphs, same output.

No schema change; the next analyze rebuilds once because the version changed.

Source: https://github.com/EMahmoudNabil/slnmap</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\viz-template.html" LogicalName="viz-template.html" />
    <EmbeddedResource Include="Resources\vis-network.min.js" LogicalName="vis-network.min.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Slnmap.Analysis\Slnmap.Analysis.csproj" />
    <ProjectReference Include="..\Slnmap.Core\Slnmap.Core.csproj" />
    <ProjectReference Include="..\Slnmap.Mcp\Slnmap.Mcp.csproj" />
    <ProjectReference Include="..\Slnmap.Storage\Slnmap.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Slnmap.Tests" />
  </ItemGroup>

</Project>
